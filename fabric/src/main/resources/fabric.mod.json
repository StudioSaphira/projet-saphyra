{
  "schemaVersion": 1,
  "id": "saphyra",
  "version": "${version}",
  "name": "Saphyra",
  "description": "Saphyra is the core framework for Studio Saphira's Minecraft mods, providing shared utilities, common systems, and technical foundations to ensure consistency, compatibility, and seamless integration across projects.",
  "icon": "logo.png",
  "authors": [
    "HeroFR",
    "Studio Saphira"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.saphyra.fabric.FabricSaphyra"
    ],
    "client": [
      "net.saphyra.fabric.FabricSaphyraClient"
    ],
    "preLaunch": [
      "net.saphyra.fabric.compat.iris.FabricIrisBootstrap"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "fabric-api": ">=0.116.17+1.21.1",
    "java": ">=21"
  },
  "mixins": [
    "saphyra.fabric.mixins.json",
    "saphyra.fabric.lighting.mixins.json",
    "saphyra.fabric.sodium.mixins.json",
    "saphyra.fabric.iris.mixins.json"
  ]
}
